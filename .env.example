# Frontend tidak lagi memerlukan kredensial Supabase. Seluruh data dilayani oleh
# Worker Cloudflare pada origin yang sama (/api/...), jadi berkas ini hanya berisi
# sakelar darurat. Semuanya menyala secara default; isi hanya bila perlu mematikan.

# VITE_ENABLE_ACCOUNT_MANAGEMENT=false   # matikan tambah/arsip akun & reset password
# VITE_ENABLE_BACKUP_RESTORE=false       # matikan menu Backup & Restore
# VITE_ENABLE_GAME_FEATURES=false        # matikan modul permainan & kuis
