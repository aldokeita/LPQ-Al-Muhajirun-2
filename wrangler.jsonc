{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lpq-al-muhajirun",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-19",

  // Worker melayani hasil build Vite sekaligus API di satu domain, jadi tidak ada CORS.
  // Rute /api/* harus lebih dulu sampai ke Worker, kalau tidak akan tertelan
  // penanganan SPA yang memulangkan index.html untuk path tak dikenal.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Menambahkan "routes" membuat wrangler mematikan workers.dev secara diam-diam,
  // jadi nilainya ditulis tegas di sini dan jangan dihapus.
  "workers_dev": true,

  // Domain publik dipasang sebagai route, bukan custom_domain. custom_domain menuntut
  // menulis catatan DNS-nya sendiri dan ditolak selama catatan lama peninggalan Vercel
  // masih ada (kode 100117). Route justru menumpang catatan terproksi yang sudah ada:
  // permintaan ke kedua nama ini dicegat Worker sebelum sampai ke asal lama, tanpa
  // menyentuh DNS sama sekali. Menghapus blok ini mengembalikan lalu lintas ke Vercel.
  "routes": [
    { "pattern": "lpqalmuhajirun.id/*", "zone_name": "lpqalmuhajirun.id" },
    { "pattern": "www.lpqalmuhajirun.id/*", "zone_name": "lpqalmuhajirun.id" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lpq-al-muhajirun",
      "database_id": "e88de8ce-95d4-4215-b6c5-7dbf324069a7"
    }
  ],

  // Satu bucket untuk seluruh berkas, dipisahkan awalan yang menggantikan tiga bucket
  // Supabase: avatars/, website-assets/, dan music-files/. Aturan aksesnya berbeda per
  // awalan dan ditegakkan worker/routes/files.js, bukan oleh bucket-nya.
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "lpq-al-muhajirun-files"
    }
  ],

  "observability": {
    "enabled": true
  }
}
